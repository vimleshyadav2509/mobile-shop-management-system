# ==============================================================================
# Mobile Shop Management System - Root Environment Template
# ==============================================================================
# Detailed configurations can be found in backend/.env.example and frontend/.env.example

# --- Backend Configuration (backend/.env) ---
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (Supabase PostgreSQL in production, SQLite fallback in development)
DATABASE_URL=

# Cloudinary Image Storage Configuration (Free Tier: 25 monthly credits)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Security: In production, generate a 32+ character random string
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin Credentials (Leave blank in production and use 'python seed_admin.py')
ADMIN_USERNAME=Amit_MS2026
ADMIN_PASSWORD=

# Shop Contact & Location Defaults
SHOP_PHONE_1=6306657432
SHOP_PHONE_2=9721996477
SHOP_LOCATION=Kuk Nagar Grint Rd, Khorare, Uttar Pradesh 271312
SHOP_LATITUDE=27.0161817
SHOP_LONGITUDE=82.5375051
SHOP_MAPS_URL=https://maps.app.goo.gl/Cumott8vek7HA85K9

# Customer Mobile OTP & SMS Provider Configuration
# Supported providers: 'fast2sms' or 'twilio'. Leave empty for development fallback.
SMS_PROVIDER=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CUSTOMER_TOKEN_EXPIRE_DAYS=30

# Allowed Origins (CORS)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistent Storage Paths (for cloud hosting with persistent disk mount e.g. /var/data)
# DB_PATH=/var/data/ams_store.db
# UPLOAD_DIR=/var/data/uploads
DB_PATH=
UPLOAD_DIR=

# Optional Services
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# --- Frontend Configuration (frontend/.env) ---
# VITE_API_URL=/api
# VITE_SHOP_PHONE_1=6306657432
# VITE_SHOP_PHONE_2=9721996477
# VITE_SHOP_LOCATION=Kuk Nagar Grint Rd, Khorare, Uttar Pradesh 271312
