# ==============================================================================
# Amit Mobile Shop - Backend Environment Template
# ==============================================================================

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development

# Server Port & Binding
PORT=8000
HOST=0.0.0.0

# Optional: Google Gemini API Key (Falls back to domain heuristics if omitted)
GEMINI_API_KEY=

# Optional: Supabase credentials (for future PostgreSQL / Supabase sync)
SUPABASE_URL=
SUPABASE_KEY=

# Contact & Address Information
SHOP_PHONE_1=6306657432
SHOP_PHONE_2=9721996477
SHOP_LOCATION=Kuk Nagar Grint Rd, Khorare, Uttar Pradesh 271312

# Admin & Owner Authentication
# In production, JWT_SECRET_KEY MUST be a strong random secret of at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin Credentials (Leave blank in production and use 'python seed_admin.py' interactively)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# CORS Configuration
# Set FRONTEND_URL and/or comma-separated ALLOWED_ORIGINS for the production frontend domain
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistent Storage Paths (Essential for cloud hosting with attached persistent volume)
# In local development: defaults to backend/ams_store.db and backend/static/uploads
# In production with attached volume (e.g. Railway volume mounted at /var/data):
# DB_PATH=/var/data/ams_store.db
# UPLOAD_DIR=/var/data/uploads
DB_PATH=
UPLOAD_DIR=
