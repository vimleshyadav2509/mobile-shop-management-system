# ==============================================================================
# Git Ignore Configuration - Mobile Shop Management System
# ==============================================================================

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.*.local
*.env
!.env.example

# SQLite & Database Files
*.db
*.sqlite
*.sqlite3
*.backup
backend/ams_store.db
backend/ams_store.db.backup

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node.js & Frontend Build Outputs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
frontend/dist - Copy/
dist/
*.timestamp-*.mjs

# Runtime Uploads & Media (Preserve folder structure with .gitkeep)
backend/static/uploads/*
!backend/static/uploads/.gitkeep
!backend/static/uploads/products/
backend/static/uploads/products/*
!backend/static/uploads/products/.gitkeep

# Logs & Temporary Files
*.log
*.tmp
*.bak
*.swp
*.swo

# IDE & Editor Configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
